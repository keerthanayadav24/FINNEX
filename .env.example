# ==================================================
# FINNEX ENVIRONMENT VARIABLES TEMPLATE
# ==================================================

# --------------------------------------------------
# FRONTEND ENVIRONMENT VARIABLES (Client-side)
# --------------------------------------------------
# Public API Base URL pointing to backend API endpoint (e.g. https://api.finnex.app/api)
VITE_API_BASE_URL="http://localhost:5000/api"

# Clerk Publishable Key (Required for Frontend Auth Provider)
VITE_CLERK_PUBLISHABLE_KEY="pk_test_YOUR_CLERK_PUBLISHABLE_KEY"

# --------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (Server-side)
# --------------------------------------------------
# PostgreSQL Database Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finnex?schema=public"

# Express API Port
PORT=5000

# Environment Mode: "development", "test", or "production"
NODE_ENV="development"

# Clerk Secret Key (Required for Backend Bearer JWT Token Verification)
CLERK_SECRET_KEY="sk_test_YOUR_CLERK_SECRET_KEY"

# Development Authentication Fallback
# Set DEV_AUTH_ENABLED=true ONLY in local development when Clerk API keys are not provided.
# Strictly forced to false when NODE_ENV=production.
DEV_AUTH_ENABLED="true"

# Deployed Frontend Web Application URL (Required for Backend CORS Validation)
FRONTEND_URL="http://localhost:5173"
