# Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finnex?schema=public"

# Server Configuration
PORT=5000
NODE_ENV="development"

# Authentication (Clerk - Required for Managed Production Auth)
VITE_CLERK_PUBLISHABLE_KEY="pk_test_YOUR_CLERK_PUBLISHABLE_KEY"
CLERK_PUBLISHABLE_KEY="pk_test_YOUR_CLERK_PUBLISHABLE_KEY"
CLERK_SECRET_KEY="sk_test_YOUR_CLERK_SECRET_KEY"

# Development Authentication Fallback
# Set DEV_AUTH_ENABLED=true ONLY in local development when Clerk API keys are not provided.
# Strictly ignored in production mode.
DEV_AUTH_ENABLED="true"

# Frontend Client URL (for CORS)
FRONTEND_URL="http://localhost:5173"
